<resources>
    <style name="Theme.RtcView" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rtcview_accent</item>
        <item name="colorPrimaryDark">@color/rtcview_bg</item>
        <item name="colorAccent">@color/rtcview_accent</item>
        <item name="android:windowBackground">@color/rtcview_bg</item>
        <!-- Transparent, not @color/rtcview_bg: both activities draw
             edge-to-edge (WindowCompat.setDecorFitsSystemWindows(false)),
             so the system bars must let the activity's own background
             (plain black in MainActivity, the glow gradient in
             SetupActivity) show through instead of painting over it. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
