<?xml version="1.0" encoding="utf-8"?>
<!-- Soft blue glow fading to black — the backdrop behind every glass
     surface in the app (Setup screen, MainActivity's connecting overlay).
     A cheap stand-in for a real blur, which isn't available below API 31. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="420dp"
        android:centerX="0.5"
        android:centerY="0.05"
        android:startColor="@color/rtcview_glow"
        android:centerColor="#140B0F1A"
        android:endColor="@color/rtcview_bg" />
</shape>
